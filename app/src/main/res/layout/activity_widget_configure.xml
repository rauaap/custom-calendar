<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/configure_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp">

            <TextView
                android:id="@+id/preview_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_permission_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_rationale"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_calendar_access"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_name_color" />

            <CheckBox
                android:id="@+id/checkbox_name_calendar_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/use_calendar_color" />

            <com.aapr.customcalendar.widget.ColorSwatchView
                android:id="@+id/swatch_name_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_date_color" />

            <CheckBox
                android:id="@+id/checkbox_date_calendar_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/use_calendar_color" />

            <com.aapr.customcalendar.widget.ColorSwatchView
                android:id="@+id/swatch_date_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_background_color" />

            <com.aapr.customcalendar.widget.ColorSwatchView
                android:id="@+id/swatch_background_color"
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_corner_radius" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/seekbar_corner_radius"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_corner_radius_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="48dp" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_lookahead_days" />

            <EditText
                android:id="@+id/edit_lookahead_days"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:gravity="end"
                android:hint="@string/hint_lookahead_days"
                android:imeOptions="actionDone" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_max_events" />

            <EditText
                android:id="@+id/edit_max_events"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:gravity="end"
                android:hint="@string/hint_max_events"
                android:imeOptions="actionDone" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/checkbox_show_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_show_empty_text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_font_size" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/seekbar_font_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="18" />

            <TextView
                android:id="@+id/text_font_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="48dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_event_format" />

        <EditText
            android:id="@+id/edit_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:imeOptions="actionDone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/format_helper_text"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
